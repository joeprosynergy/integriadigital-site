---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/lovable/HeroSection.tsx";
---

<Layout
  title="Software Consulting for Efficient Business Workflows | Integria Digital"
  description="We help businesses choose, implement, and adopt software that teams actually use."
>
  <main>
    <main class="bg-background">
    <!-- Hero -->
    <HeroSection client:load />

    <!-- What We Do -->
    <section>
      <h2>What We Do</h2>
      <ul>
        <li>Software selection & implementation</li>
        <li>Workflow optimisation</li>
        <li>Reporting & clarity</li>
      </ul>
    </section>

    <!-- Contact CTA -->
    <section>
      <h2>Let’s Talk</h2>
      <a href="/contact">Contact us</a>
    </section>
  </main>
</Layout>
