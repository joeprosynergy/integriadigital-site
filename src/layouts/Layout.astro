---
/* Import global styles the Astro way */
import "../styles/globals.css";

const {
  title = "Integria Digital | Software Consulting",
  description = "Software consulting for efficient, transparent business workflows.",
  canonical = "https://integria.digital/",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="robots" content="index, follow" />
  </head>

  <body class="antialiased bg-background text-foreground">
    <slot />
  </body>
</html>